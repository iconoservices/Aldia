rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Desde el esquema 2 cada colección es un documento propio: users/{uid}/datos/{coleccion}
      match /datos/{coleccion} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
